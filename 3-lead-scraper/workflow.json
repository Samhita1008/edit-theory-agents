        0
      ],
      "id": "c29f80bb-0f2c-49fa-be6c-4e3381bc483d",
      "name": "Parse Groq Response"
    },
    {
      "parameters": {
        "jsCode": "let text = $json.choices[0].message.content;\n\ntext = text\n.replace(/```json/g, \"\")\n.replace(/```/g, \"\")\n.trim();\n\nconst result = JSON.parse(text);\n\n// Get data from the node BEFORE Generate Email.\n// Replace the node name below if yours is different.\n\nconst lead = $('Parse Groq Response').first().json;\n\nreturn [{\n  json: {\n\n    name: lead.name,\n\n    platform: lead.platform,\n\n    niche: $('Validate Input').first().json.niche,\n\n    profile: lead.profile,\n\n    topic: lead.topic,\n\n    score: lead.score,\n\n    language: lead.language,\n\n    opener: result.opener,\n\n    coldEmail: result.email\n\n  }\n}];"
      },
