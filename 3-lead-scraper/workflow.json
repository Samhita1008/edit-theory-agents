    {
      "parameters": {
        "jsCode": "const body = $json.body;\n\nif (!body.niche)\n    throw new Error(\"Missing niche\");\n\nif (!body.min_followers)\n    throw new Error(\"Missing min_followers\");\n\nif (!body.max_followers)\n    throw new Error(\"Missing max_followers\");\n\nreturn [{\n    json:{\n        niche: body.niche,\n        min_followers: body.min_followers,\n        max_followers: body.max_followers\n    }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        176,
        -64
      ],
      "id": "4bc352e8-82cc-49db-b735-fc3f93fadcd4",
      "name": "Validate Input"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_GROQ_API_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\":\"llama-3.3-70b-versatile\",\n  \"messages\":[\n    {\n      \"role\":\"system\",\n      \"content\":\"You are an Instagram marketing expert. Return ONLY valid JSON.\"\n    },\n    {\n      \"role\":\"user\",\n      \"content\":\"Generate exactly 5 Instagram hashtags related to {{$json.niche}}. Return JSON like {\\\"hashtags\\\":[\\\"skincare\\\",\\\"glassskin\\\",\\\"beauty\\\"]}. Do not include #.\"\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        320,
        32
      ],
      "id": "351e7976-5ab0-40cc-b1ac-c6bf50d9eb47",
      "name": "Generate Hashtags"
    },
    {
      "parameters": {
        "jsCode": "let text = $json.choices[0].message.content;\n\ntext = text\n.replace(/```json/g,'')\n.replace(/```/g,'')\n.trim();\n\nconst hashtags = JSON.parse(text);\n\nreturn hashtags.hashtags.map(tag=>({\n    json:{\n        hashtag:tag\n    }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        -112
      ],
      "id": "37de6eb7-7538-4dc8-8dca-f80ea6dd7087",
      "name": "Parse Hashtags"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/apify~instagram-hashtag-scraper/runs?token=YOUR_APIFY_TOKEN",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"hashtags\": [\n    \"={{$json.hashtag.replace('#','')}}\"\n  ],\n  \"resultsLimit\": 25\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        640,
        -48
      ],
      "id": "587c1a5c-ef6e-4583-bfbe-b5d6d742c7bf",
      "name": "Scrape Instagram",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    hashtag: $('Parse Hashtags').item.json.hashtag,\n    defaultDatasetId: $json.data.defaultDatasetId,\n    runId: $json.data.id\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        48
      ],
      "id": "e4dc42d6-ffa2-445c-b1fc-5e7ca0b54468",
      "name": "Extract Dataset ID"
    },
    {
      "parameters": {
        "url": "==https://api.apify.com/v2/datasets/{{$('Extract Dataset ID').item.json.defaultDatasetId}}/items?clean=true",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1200,
        -208
      ],
      "id": "11cb56e5-f4a1-4381-841d-f9b93db65ff2",
      "name": "Get Results"
    },
    {
      "parameters": {
        "jsCode": "const post = $json;\n\nreturn [{\n    json: {\n\n        username: post.ownerUsername,\n\n        name: post.ownerFullName ||\n\n              post.ownerUsername,\n\n        followers:\n\n            post.ownerFollowers ||\n\n            0,\n\n        profile:\n\n            \"https://instagram.com/\" +\n\n            post.ownerUsername,\n\n        topic:\n\n            post.caption ||\n\n            \"\",\n\n        platform:\n\n            \"Instagram\"\n    }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1408,
        64
      ],
      "id": "da9a0de6-e173-460c-b351-fb82b4a67d89",
      "name": "Format Lead"
    },
    {
      "parameters": {
        "jsCode": "const seen = new Set();\nconst unique = [];\n\nfor (const item of $input.all()) {\n\n    const username = item.json.username;\n\n    if (seen.has(username))\n\n        continue;\n\n    seen.add(username);\n\n    unique.push(item);\n}\n\nreturn unique;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1536,
        -144
      ],
      "id": "648c995f-9a2b-470c-a8c3-0b57897b329d",
      "name": "Deduplicate Leads"
    },
    {
      "parameters": {
        "jsCode": "const config = $('Validate Input').first().json;\n\nconst min = config.min_followers;\nconst max = config.max_followers;\n\nreturn $input.all().filter(item => {\n\n    const followers = item.json.followers;\n\n    return followers >= min &&\n           followers <= max;\n\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
