      "id": "ec8ede2c-51c2-4f1a-910c-ca6e73194ea4",
      "name": "Generate Personalized Opener + Cold Email"
    },
    {
      "parameters": {
        "jsCode": "let text = $json.choices[0].message.content;\n\ntext = text\n.replace(/```json/g, '')\n.replace(/```/g, '')\n.trim();\n\nconst ai = JSON.parse(text);\n\nreturn [{\n  json: {\n    ...$('Filter Followers').item.json,\n    score: ai.score,\n    language: ai.language,\n    reason: ai.reason\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
