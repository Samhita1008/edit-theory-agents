        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Return ONLY valid JSON. No markdown. No backticks.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Analyze this Instagram creator.\\n\\nName: {{$json.name}}\\nUsername: {{$json.username}}\\nFollowers: {{$json.followers}}\\nRecent Post: {{$json.topic}}\\n\\nReturn JSON:\\n{\\n\\\"score\\\":8,\\n\\\"language\\\":\\\"English\\\",\\n\\\"reason\\\":\\\"short reason\\\"\\n}\"\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
