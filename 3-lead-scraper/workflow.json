    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\":\"llama-3.3-70b-versatile\",\n  \"messages\":[\n    {\n      \"role\":\"system\",\n      \"content\":\"Return ONLY JSON.\"\n    },\n    {\n      \"role\":\"user\",\n      \"content\":\"You work for [Your Brand], a D2C skincare brand.\\n\\nLead Information:\\n\\nName: {{$json.name}}\\nUsername: {{$json.username}}\\nFollowers: {{$json.followers}}\\nRecent Post: {{$json.topic}}\\nLanguage: {{$json.language}}\\nLead Score: {{$json.score}}\\n\\nGenerate:\\n1. A friendly personalized opener.\\n2. A professional cold email.\\n\\nReturn:\\n{\\n\\\"opener\\\":\\\"...\\\",\\n\\\"email\\\":\\\"...\\\"\\n}\"\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
