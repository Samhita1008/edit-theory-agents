    {
      "parameters": {
        "jsCode": "const segments = items[0].json.content;\nconst fullText = segments.map(seg => seg.text).join(' ');\n\n// Cap to ~12000 characters (~3000 tokens) to keep Groq happy\nconst trimmed = fullText.length > 12000 ? fullText.slice(0, 12000) + '...' : fullText;\n\nreturn [{ json: { transcript: trimmed } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [416, 0],
      "id": "97a2e8c4-c59b-48de-82fe-388cffffdb4b",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_GROQ_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"llama-3.3-70b-versatile\",\n  messages: [\n    {\n      role: \"system\",\n      content: \"You are a content repurposing assistant. Given a podcast/video transcript, generate 10 content assets and return ONLY valid JSON, no markdown fences, no preamble. Format: {\\\"carousel_slides\\\": \\\"5-slide LinkedIn carousel outline, one line per slide\\\", \\\"reel_script_1\\\": \\\"15-30 second reel script, hook + payoff\\\", \\\"reel_script_2\\\": \\\"different angle reel script\\\", \\\"reel_script_3\\\": \\\"different angle reel script\\\", \\\"linkedin_post\\\": \\\"full LinkedIn post, 150-200 words\\\", \\\"newsletter\\\": \\\"email newsletter version, 200-250 words\\\", \\\"quote_post\\\": \\\"one powerful standalone quote from the content\\\", \\\"instagram_caption\\\": \\\"IG caption with line breaks and emoji, under 150 words\\\", \\\"x_thread\\\": \\\"5-tweet thread, numbered\\\", \\\"ad_concept\\\": \\\"one ad concept: hook + angle + CTA\\\"}\"\n    },\n    {\n      role: \"user\",\n      content: \"Transcript: \" + $json.transcript\n    }\n  ],\n  temperature: 0.4\n}) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [624, 0],
      "id": "31d49061-1e33-4ea2-bfb2-19544cafa2fd",
      "name": "HTTP Request1"
    },
    {
      "parameters": {
        "jsCode": "return items.map((item) => {\n  const raw = item.json.choices[0].message.content;\n  const clean = raw.replace(/```json|```/g, '').trim();\n  const parsed = JSON.parse(clean);\n\n  return {\n    json: {\n      carousel_slides: parsed.carousel_slides,\n      reel_script_1: parsed.reel_script_1,\n      reel_script_2: parsed.reel_script_2,\n      reel_script_3: parsed.reel_script_3,\n      linkedin_post: parsed.linkedin_post,\n      newsletter: parsed.newsletter,\n      quote_post: parsed.quote_post,\n      instagram_caption: parsed.instagram_caption,\n      x_thread: parsed.x_thread,\n      ad_concept: parsed.ad_concept\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
